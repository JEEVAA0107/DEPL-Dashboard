# ==============================================================================
# DEPL TEXTILE ERP DASHBOARD – DATABASE CONNECTION CONFIGURATION
# ==============================================================================
# NOTE: The dashboard runs strictly READ-ONLY SELECT queries.
# No ALTER, DROP, INSERT, or DELETE queries will ever be executed.
# ==============================================================================

# Database Engine Type: mssql | postgres | mysql
DB_TYPE=mssql

# Direct Connection String (Option 1)
# DATABASE_URL=sqlserver://username:password@hostname:1433;database=DEPL_ERP;encrypt=true;trustServerCertificate=true

# Discrete Credentials (Option 2)
DB_HOST=192.168.1.150
DB_PORT=1433
DB_NAME=DEPL_ERP
DB_USER=readonly_user
DB_PASSWORD=your_password_here

# ERP Table / View Mapping
# TBL_VENDOR_INWARD=vw_vendor_inward
# TBL_PURCHASE_INWARD=vw_purchase_inward
# TBL_PROCESS_DELIVERY=vw_process_delivery
# TBL_PROCESS_INWARD=vw_process_inward
# TBL_SALES_DELIVERY=vw_sales_delivery
# TBL_IBPO=vw_ibpo_orders
# TBL_IMPO=vw_impo_orders
